From de5699168fe8ba8d1f9d72488c6c000676898d3a Mon Sep 17 00:00:00 2001
From: Prateek Mittal <finance.prateek.mittal@gmail.com>
Date: Sun, 18 Oct 2026 06:07:19 +0530
Subject: [PATCH 1/2] avdtp: Keep the session on an unanswered Abort

An Abort for a stream that is still CONFIGURED has no media transport to
release, but the request timer treats a missing response like any other
failed request and calls connection_lost().  Some sinks ignore the Abort
in that state, so a reconfiguration attempt disconnects A2DP.

Mark an Abort issued for a CONFIGURED stream as local.  If the request
times out, notify the local SEP callback with success and release the
stream instead of dropping the AVDTP session.  The Abort is still sent;
only the local teardown is completed without a response.

Assisted-by: DeepSeekHarness:deepseek-v4.1-flash-1017
---
 profiles/audio/avdtp.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/profiles/audio/avdtp.c b/profiles/audio/avdtp.c
index 56d27b9..936aa9c 100644
--- a/profiles/audio/avdtp.c
+++ b/profiles/audio/avdtp.c
@@ -364,6 +364,7 @@ struct avdtp_stream {
 	gboolean open_acp;	/* If we are in ACT role for Open */
 	gboolean close_int;	/* If we are in INT role for Close */
 	gboolean abort_int;	/* If we are in INT role for Abort */
+	gboolean abort_local;	/* Abort of a stream that was never opened */
 	unsigned int start_timer;	/* Wait START command timer */
 	gboolean delay_reporting;
 	uint16_t delay;		/* AVDTP 1.3 Delay Reporting feature */
@@ -2644,6 +2645,24 @@ static int cancel_request(struct avdtp *session, int err)
 		goto failed;
 	case AVDTP_ABORT:
 		error("Abort: %s (%d)", strerror(err), err);
+
+		/* The peer did not acknowledge the Abort.  For a stream that
+		 * was still CONFIGURED there is nothing to tear down on the
+		 * transport, so release it locally instead of declaring the
+		 * AVDTP session lost.
+		 */
+		if (err == ETIMEDOUT && stream && stream->abort_local) {
+			warn("Abort not acknowledged, releasing stream");
+			stream->abort_local = FALSE;
+
+			if (lsep && lsep->cfm && lsep->cfm->abort)
+				lsep->cfm->abort(session, lsep, stream, NULL,
+							lsep->user_data);
+
+			avdtp_stream_set_state(stream, AVDTP_STATE_IDLE);
+			goto done;
+		}
+
 		goto failed;
 	}
 
@@ -3785,6 +3804,13 @@ int avdtp_abort(struct avdtp *session, struct avdtp_stream *stream)
 	if (stream->state == AVDTP_STATE_ABORTING)
 		return -EINVAL;
 
+	/* A stream that was never opened has no transport to release.  Keep
+	 * the session up if the peer does not answer the Abort: the local
+	 * stream can be released without a round trip.
+	 */
+	if (stream->state == AVDTP_STATE_CONFIGURED)
+		stream->abort_local = TRUE;
+
 	avdtp_stream_set_state(stream, AVDTP_STATE_ABORTING);
 
 	if (session->req && stream == session->req->stream)
