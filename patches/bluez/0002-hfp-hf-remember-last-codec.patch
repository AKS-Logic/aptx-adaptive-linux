+static void hfp_hf_store_codec(struct hfp_device *dev)
+{
+	struct btd_device *device;
+	struct btd_adapter *adapter;
+	char filename[PATH_MAX];
+	char dst_addr[18];
+	GKeyFile *key_file;
+	GError *gerr = NULL;
+	char *data;
+	size_t len = 0;
+
+	device = telephony_get_device(dev->telephony);
+
+	if (!device)
+		return;
+
+	adapter = device_get_adapter(device);
+
+	if (!adapter)
+		return;
+
+	ba2str(device_get_address(device), dst_addr);
+
+	create_filename(filename, PATH_MAX, "/%s/cache/%s",
+			btd_adapter_get_storage_dir(adapter), dst_addr);
+
+	key_file = g_key_file_new();
+
+	if (!g_key_file_load_from_file(key_file, filename, 0, &gerr))
+		g_clear_error(&gerr);
+
+	g_key_file_set_integer(key_file, "HFP", "LastCodec", dev->codec);
+
+	data = g_key_file_to_data(key_file, &len, NULL);
+
+	if (!g_file_set_contents(filename, data, len, &gerr)) {
+		error("Unable to set contents for %s: (%s)", filename,
+							gerr->message);
+		g_error_free(gerr);
+	}
+
+	g_free(data);
+	g_key_file_free(key_file);
+}
+
+static uint8_t hfp_hf_load_codec(struct btd_device *device)
+{
+	struct btd_adapter *adapter;
+	char filename[PATH_MAX];
+	char dst_addr[18];
+	GKeyFile *key_file;
+	GError *gerr = NULL;
+	int codec;
+
+	adapter = device_get_adapter(device);
+
+	if (!adapter)
+		return 1;
+
+	ba2str(device_get_address(device), dst_addr);
+
+	create_filename(filename, PATH_MAX, "/%s/cache/%s",
+			btd_adapter_get_storage_dir(adapter), dst_addr);
+
+	key_file = g_key_file_new();
+
+	if (!g_key_file_load_from_file(key_file, filename, 0, &gerr)) {
+		g_clear_error(&gerr);
+		g_key_file_free(key_file);
+
+		return 1;
+	}
+
+	codec = g_key_file_get_integer(key_file, "HFP", "LastCodec", &gerr);
+
+	if (gerr) {
+		g_clear_error(&gerr);
+		g_key_file_free(key_file);
+
+		return 1;
+	}
+
+	g_key_file_free(key_file);
+
+	if (codec <= 0 || codec > UINT8_MAX)
+		return 1;
+
+	return (uint8_t) codec;
+}
