+/* Publish a codec configuration that was negotiated on the running stream
+ * (AVDTP RECONFIGURE) so that observers - PipeWire's bluez5 sink - can bring
+ * the node up with the new configuration while the transport stays acquired. */
+void media_transport_update_configuration(struct btd_device *device,
+					const uint8_t *configuration,
+					size_t size)
+{
+	GSList *l;
+
+	if (!device || !configuration || !size)
+		return;
+
+	for (l = transports; l; l = g_slist_next(l)) {
+		struct media_transport *transport = l->data;
+
+		if (transport->device != device)
+			continue;
+
+		if (transport->size == (int) size &&
+				!memcmp(transport->configuration,
+					configuration, size))
+			return;
+
+		g_free(transport->configuration);
+		transport->configuration = util_memdup(configuration, size);
+		transport->size = size;
+
+		DBG("%s: configuration updated", transport->path);
+
+		g_dbus_emit_property_changed(btd_get_dbus_connection(),
+					transport->path,
+					MEDIA_TRANSPORT_INTERFACE,
+					"Configuration");
+		return;
+	}
+}
