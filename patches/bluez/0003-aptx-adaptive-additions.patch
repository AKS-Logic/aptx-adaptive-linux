@@ -1751,6 +1766,328 @@ static struct a2dp_remote_sep *find_remote_sep(struct a2dp_channel *chan,
 	return queue_find(chan->seps, match_remote_sep, rsep);
 }
 
+static void caps_add_codec(GSList **l, uint8_t codec, uint8_t *caps,
+							size_t size);
+
+static struct a2dp_server *find_server(GSList *servers,
+					struct btd_adapter *adapter);
+
+/* Single-flight state for a run-time codec reconfiguration: the peer MOMENTUM 5
+ * rejects AVDTP RECONFIGURE (0x17), so the configuration is changed the way
+ * BlueZ already does it for a new codec: the stream is closed and set up again
+ * with the new capabilities, which keeps the ACL and the connection. */
+static struct {
+	struct avdtp *session;
+	struct a2dp_sep *sep;
+	GSList *caps;
+	a2dp_reconfigure_cb_t cb;
+	void *user_data;
+	gint64 started;
+} reconfig;
+
+/* bluetoothd runs with a restricted capability set (no CAP_DAC_OVERRIDE), so it
+ * cannot read the user's $XDG_RUNTIME_DIR.  The request and status files live
+ * in a directory the daemon owns instead: the request is world-writable so the
+ * unprivileged control tool can drop a nonce in it, the status is world
+ * readable so the tool can see the outcome.
+ */
+#define RECONF_DIR "/run/aptx-adaptive"
+#define RECONF_REQUEST RECONF_DIR "/request"
+#define RECONF_STATUS RECONF_DIR "/status"
+
+static gboolean rate_seen_init;
+static char *rate_seen;
+
+static void reconf_status_write(const char *state)
+{
+	if (!g_file_set_contents(RECONF_STATUS, state, -1, NULL)) {
+		error("reconfigure: unable to write " RECONF_STATUS);
+		return;
+	}
+
+	chmod(RECONF_STATUS, 0644);
+}
+
+static char *request_read(void)
+{
+	char buf[64];
+	size_t len;
+	FILE *f;
+
+	f = fopen(RECONF_REQUEST, "r");
+	if (!f)
+		return NULL;
+
+	if (!fgets(buf, sizeof(buf), f)) {
+		fclose(f);
+		return NULL;
+	}
+
+	fclose(f);
+
+	len = strlen(buf);
+	while (len && g_ascii_isspace(buf[len - 1]))
+		buf[--len] = '\0';
+
+	return g_strdup(buf);
+}
+
+static void reconfigure_finish(int err)
+{
+	a2dp_reconfigure_cb_t cb = reconfig.cb;
+	void *user_data = reconfig.user_data;
+	char status[96];
+
+	if (err < 0)
+		g_snprintf(status, sizeof(status), "%s error %s",
+				rate_seen ? rate_seen : "-", strerror(-err));
+	else
+		g_snprintf(status, sizeof(status), "%s ok",
+				rate_seen ? rate_seen : "-");
+
+	reconf_status_write(status);
+
+	/* a2dp_config() hands a copy of the list to its setup, which owns the
+	 * capability elements: only the nodes may be freed here. */
+	g_slist_free(reconfig.caps);
+
+	memset(&reconfig, 0, sizeof(reconfig));
+
+	if (cb)
+		cb(NULL, err, user_data);
+}
+
+static void reconfigure_config_cb(struct avdtp *session, struct a2dp_sep *sep,
+					struct avdtp_stream *stream, int err,
+					void *user_data)
+{
+	if (err < 0) {
+		error("reconfigure: unable to set up the stream: %s",
+							strerror(-err));
+		reconfigure_finish(err);
+		return;
+	}
+
+	DBG("reconfigure: stream re-opened with the new configuration");
+
+	reconfigure_finish(0);
+}
+
+static void reconfigure_select_cb(struct a2dp_setup *setup, void *ret,
+					int size)
+{
+	GSList *caps = NULL;
+
+	if (size < 0) {
+		error("Unable to select a configuration for the rate change");
+		reconfigure_finish(-EINVAL);
+		return;
+	}
+
+	caps_add_codec(&caps, reconfig.sep->codec, ret, size);
+
+	/* The elements are handed over to a2dp_config()'s setup below. */
+	g_slist_free(reconfig.caps);
+	reconfig.caps = caps;
+
+	/* a2dp_config() closes a stream that is already open and negotiates it
+	 * again with these capabilities, so the codec configuration - including
+	 * the sample rate - changes while the connection stays up. */
+	if (a2dp_config(reconfig.session, reconfig.sep, reconfigure_config_cb,
+								caps, NULL))
+		return;
+
+	error("reconfigure: unable to renegotiate the stream");
+	reconfigure_finish(-EIO);
+}
+
+static gint match_sep_lsep(gconstpointer data, gconstpointer user_data)
+{
+	const struct a2dp_sep *sep = data;
+
+	if (sep->endpoint == NULL || sep->lsep != user_data)
+		return -1;
+
+	return 0;
+}
+
+static struct a2dp_sep *find_sep_by_lsep(struct a2dp_server *server,
+					struct avdtp_local_sep *lsep)
+{
+	GSList *l;
+
+	if (!lsep)
+		return NULL;
+
+	l = g_slist_find_custom(server->sinks, lsep, match_sep_lsep);
+	if (!l)
+		l = g_slist_find_custom(server->sources, lsep, match_sep_lsep);
+
+	return l ? l->data : NULL;
+}
+
+unsigned int a2dp_reconfigure_stream(struct avdtp *session,
+				a2dp_reconfigure_cb_t cb, void *user_data)
+{
+	struct a2dp_channel *chan;
+	struct a2dp_server *server;
+	struct a2dp_sep *sep;
+	struct avdtp *rec_session;
+	struct avdtp_remote_sep *rsep;
+	struct avdtp_service_capability *service;
+	struct avdtp_media_codec_capability *codec;
+	int err;
+
+	if (reconfig.session) {
+		/* A reply that never came must not block every later attempt. */
+		if (g_get_monotonic_time() - reconfig.started <
+					10 * G_TIME_SPAN_SECOND)
+			return 0;
+		error("previous reconfigure timed out, starting over");
+		reconfigure_finish(-ETIMEDOUT);
+	}
+
+	if (!last_stream) {
+		error("reconfigure: no recorded stream");
+		return 0;
+	}
+
+	rec_session = avdtp_stream_get_session(last_stream);
+	if (rec_session)
+		session = rec_session;
+
+	chan = find_channel(session);
+	if (!chan) {
+		error("reconfigure: no channel");
+		return 0;
+	}
+
+	server = find_server(servers, device_get_adapter(chan->device));
+	if (!server) {
+		error("reconfigure: no server");
+		return 0;
+	}
+
+	/* The *capabilities of the remote SEP* - not the configuration that is
+	 * in force - so the endpoint can pick any rate the peer offers. */
+	rsep = avdtp_stream_get_remote_sep(last_stream);
+	if (!rsep) {
+		error("reconfigure: no remote sep for the stream");
+		return 0;
+	}
+
+	service = avdtp_get_codec(rsep);
+	if (!service) {
+		error("reconfigure: remote sep has no codec");
+		return 0;
+	}
+
+	codec = (struct avdtp_media_codec_capability *) service->data;
+
+	/* The local SEP that owns the running stream, i.e. the endpoint to ask
+	 * for the new configuration (Adaptive, not plain aptX). */
+	sep = find_sep_by_lsep(server, avdtp_stream_get_lsep(last_stream));
+	if (!sep || !sep->endpoint) {
+		error("reconfigure: no local endpoint sep");
+		return 0;
+	}
+
+	reconfig.session = session;
+	reconfig.sep = sep;
+	reconfig.cb = cb;
+	reconfig.user_data = user_data;
+	reconfig.started = g_get_monotonic_time();
+
+	/* Ask the endpoint (PipeWire) for a configuration again; the SPA codec
+	 * reads the wanted rate from its run-time file at this point. */
+	err = sep->endpoint->select_configuration(sep, codec->data,
+					service->length - sizeof(*codec),
+					NULL, reconfigure_select_cb,
+					sep->user_data);
+	if (err == 0)
+		return 1;
+
+	memset(&reconfig, 0, sizeof(reconfig));
+
+	return 0;
+}
+
+static gboolean rate_poll(gpointer user_data)
+{
+	char *value = request_read();
+
+	if (!value) {
+		/* No request file yet: remember that, so the first request that
+		 * appears afterwards is acted on. */
+		rate_seen_init = TRUE;
+		return G_SOURCE_CONTINUE;
+	}
+
+	if (!rate_seen_init) {
+		/* Remember what had been requested before bluetoothd started,
+		 * so an old request does not reconfigure a fresh link. */
+		rate_seen_init = TRUE;
+		rate_seen = value;
+		return G_SOURCE_CONTINUE;
+	}
+
+	if (!g_strcmp0(rate_seen, value)) {
+		g_free(value);
+		return G_SOURCE_CONTINUE;
+	}
+
+	g_free(rate_seen);
+	rate_seen = value;
+
+	DBG("reconfigure request: %s", value);
+
+	if (!last_stream) {
+		char status[96];
+
+		g_snprintf(status, sizeof(status), "%s error no stream", value);
+		reconf_status_write(status);
+		return G_SOURCE_CONTINUE;
+	}
+
+	a2dp_reconfigure_stream(NULL, NULL, NULL);
+
+	return G_SOURCE_CONTINUE;
+}
+
+static void rate_poll_start(void)
+{
+	static gboolean started;
+	int fd;
+
+	if (started)
+		return;
+
+	started = TRUE;
+
+	if (g_mkdir_with_parents(RECONF_DIR, 0755) < 0)
+		error("reconfigure: cannot create " RECONF_DIR);
+	/* bluetoothd runs with a restrictive umask, so the directory may end up
+	 * unreadable for the unprivileged control tool; it must stay traversable
+	 * for the request file to be usable. */
+	if (chmod(RECONF_DIR, 0755) < 0)
+		error("reconfigure: cannot chmod " RECONF_DIR);
+
+	/* The control tool runs unprivileged: it has to be able to write the
+	 * request file, and to read the status file. */
+	fd = open(RECONF_REQUEST, O_CREAT | O_RDWR, 0666);
+	if (fd < 0)
+		error("reconfigure: cannot create " RECONF_REQUEST);
+	else {
+		if (fchmod(fd, 0666) < 0)
+			error("reconfigure: cannot chmod " RECONF_REQUEST);
+		close(fd);
+	}
+
+	DBG("watching " RECONF_REQUEST " for reconfigure requests");
+
+	g_timeout_add_seconds(1, rate_poll, NULL);
+}
+
 static gboolean a2dp_reconfigure(gpointer data)
 {
 	struct a2dp_setup *setup = data;
@@ -3212,6 +3549,8 @@ static struct a2dp_server *a2dp_server_register(struct btd_adapter *adapter)
 
 	servers = g_slist_append(servers, server);
 
+	rate_poll_start();
+
 	return server;
 }
 
