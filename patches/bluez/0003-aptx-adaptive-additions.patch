+/* The stream that is running, recorded when it starts, so the run-time
+ * reconfigure does not have to guess the AVDTP session. */
+static struct avdtp_stream *last_stream;
+
 static void stream_state_changed(struct avdtp_stream *stream,
 					avdtp_state_t old_state,
 					avdtp_state_t new_state,
