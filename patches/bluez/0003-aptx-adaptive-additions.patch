+int avdtp_reconfigure(struct avdtp *session, struct avdtp_stream *stream,
+			GSList *caps, avdtp_reconfigure_cb_t cb,
+			void *user_data)
+{
+	struct setconf_req *req;
+	unsigned char *ptr;
+	int err, caps_len;
+	struct avdtp_service_capability *cap;
+	GSList *l;
+
+	if (session->state != AVDTP_SESSION_STATE_CONNECTED)
+		return -ENOTCONN;
+
+	if (!stream)
+		return -EINVAL;
+
+	if (stream->state != AVDTP_STATE_STREAMING &&
+					stream->state != AVDTP_STATE_OPEN)
+		return -EINVAL;
+
+	if (stream->session != session)
+		return -EINVAL;
+
+	for (l = caps, caps_len = 0; l != NULL; l = g_slist_next(l)) {
+		cap = l->data;
+		caps_len += cap->length + 2;
+	}
+
+	req = g_malloc0(sizeof(struct setconf_req) + caps_len);
+
+	req->int_seid = stream->lsep->info.seid;
+	req->acp_seid = stream->rseid;
+
+	for (l = caps, ptr = req->caps; l != NULL; l = g_slist_next(l)) {
+		cap = l->data;
+		memcpy(ptr, cap, cap->length + 2);
+		ptr += cap->length + 2;
+	}
+
+	DBG("%p: int_seid=%u, acp_seid=%u", session,
+			stream->lsep->info.seid, stream->rseid);
+
+	session->reconfigure_cb = cb;
+	session->reconfigure_user_data = user_data;
+
+	err = send_request(session, FALSE, stream, AVDTP_RECONFIGURE, req,
+				sizeof(struct setconf_req) + caps_len);
+
+	g_free(req);
+
+	if (err < 0) {
+		session->reconfigure_cb = NULL;
+		session->reconfigure_user_data = NULL;
+		return err;
+	}
+
+	/* Keep the new configuration for later requests/answers. */
+	g_slist_free_full(stream->caps, g_free);
+	stream->caps = NULL;
+	g_slist_foreach(caps, copy_capabilities, &stream->caps);
+
+	return 0;
+}
